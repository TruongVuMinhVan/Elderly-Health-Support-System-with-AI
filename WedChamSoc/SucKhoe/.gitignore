# Environment variables - SECURITY
.env
.env.local
.env.production
.env.development
# Allow .env.example
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Only ignore lib/ at root level (Python), not mobile/lib/ (Flutter)
/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Dataset - ignore entire dataset directories
dataset/
dataset_10classes/
dataset_*/  # Any dataset_* directories
# But keep .gitkeep files if needed
!dataset/**/.gitkeep
!dataset_10classes/**/.gitkeep

# Model files (too large for git, use Git LFS or external storage)
backend/models/*.pth
backend/models/*.pt
backend/models/*.pkl
backend/models/*.h5
backend/models/*.hdf5
backend/models/*.ckpt
backend/models/*.safetensors

# Specifically ignore model files by name
backend/models/resnet*.pth
backend/models/resnet*.pt
backend/models/*resnet*.pth
backend/models/*resnet*.pt
backend/models/vit*.pth
backend/models/vit*.pt
backend/models/*vit*.pth
backend/models/*vit*.pt
backend/models/efficientnet*.pth
backend/models/efficientnet*.pt
backend/models/*efficientnet*.pth
backend/models/*efficientnet*.pt
backend/models/*_best.pth
backend/models/*_best.pt
backend/models/*_final.pth
backend/models/*_final.pt
backend/models/*_checkpoint.pth
backend/models/*_checkpoint.pt
backend/models/*checkpoint*.pth
backend/models/*checkpoint*.pt

# Ignore entire checkpoints directory (including all subdirectories)
backend/models/checkpoints/
backend/models/checkpoints/**/*

# But keep label maps, history files in models root, and other configs
!backend/models/label_map*.json
!backend/models/*history*.json
!backend/models/*.py
!backend/models/.gitkeep
!backend/models/__init__.py
